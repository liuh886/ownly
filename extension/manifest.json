{
  "manifest_version": 3,
  "name": "Ownly Capture",
  "version": "0.5.2",
  "description": "Capture travel research from Google Maps, Booking.com, Tabelog and Xiaohongshu into Ownly Planner, with selection FX conversion.",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://*.google.com/*",
    "https://*.google.co.th/*",
    "https://*.google.com.hk/*",
    "https://*.google.co.jp/*",
    "https://*.google.com.tw/*",
    "https://*.google.com.sg/*",
    "https://*.google.com.my/*",
    "https://*.google.co.uk/*",
    "https://*.google.com.au/*",
    "https://*.google.ca/*",
    "https://*.google.com.bz/*",
    "https://maps.google.com/*",
    "https://maps.google.co.th/*",
    "https://maps.google.co.jp/*",
    "https://maps.google.com.hk/*",
    "https://maps.google.com.tw/*",
    "https://maps.app.goo.gl/*",
    "https://goo.gl/*",
    "https://www.booking.com/*",
    "https://tabelog.com/*",
    "https://*.tabelog.com/*",
    "https://www.xiaohongshu.com/*",
    "https://open.er-api.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ownly Capture"
  },
  "commands": {
    "quick-capture-place": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Quickly capture current place to active trip"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://*.google.com/maps/*",
        "https://*.google.co.th/maps/*",
        "https://*.google.com.hk/maps/*",
        "https://*.google.co.jp/maps/*",
        "https://*.google.com.tw/maps/*",
        "https://*.google.com.sg/maps/*",
        "https://*.google.com.bz/maps/*",
        "https://www.google.com/travel/*",
        "https://*.google.com/travel/*",
        "https://*.google.co.th/travel/*",
        "https://*.google.com.hk/travel/*",
        "https://*.google.co.jp/travel/*",
        "https://*.google.com.tw/travel/*",
        "https://*.google.com.sg/travel/*",
        "https://*.google.com.my/travel/*",
        "https://*.google.co.uk/travel/*",
        "https://*.google.com.au/travel/*",
        "https://*.google.ca/travel/*",
        "https://*.google.com.bz/*",
        "https://*.google.com.bz/travel/*",
        "https://maps.google.com/*",
        "https://maps.google.co.th/*",
        "https://maps.google.co.jp/*",
        "https://maps.google.com.hk/*",
        "https://maps.google.com.tw/*",
        "https://www.booking.com/*",
        "https://tabelog.com/*",
        "https://*.tabelog.com/*",
        "https://www.xiaohongshu.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "fx-tooltip.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://liuh886.github.io/ownly/*",
        "https://zhihaol.eu.org/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "ownly-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
