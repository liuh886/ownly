{
  "manifest_version": 3,
  "name": "Ownly Capture",
  "version": "0.5.0",
  "description": "Capture personal travel research from Google Maps into Ownly Planner.",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://maps.google.com/*",
    "https://maps.app.goo.gl/*",
    "https://goo.gl/*",
    "https://www.booking.com/*",
    "https://tabelog.com/*",
    "https://*.tabelog.com/*",
    "https://www.xiaohongshu.com/*",
    "https://open.er-api.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ownly Capture"
  },
  "commands": {
    "quick-capture-place": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Quickly capture current place to active trip"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://maps.google.com/*",
        "https://www.booking.com/*",
        "https://tabelog.com/*",
        "https://*.tabelog.com/*",
        "https://www.xiaohongshu.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://liuh886.github.io/ownly/*",
        "https://zhihaol.eu.org/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "ownly-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
