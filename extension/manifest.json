{
  "manifest_version": 3,
  "name": "Ownly Capture",
  "version": "0.1.0",
  "description": "Capture personal travel research from Google Maps into Ownly Planner.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": [
    "https://*.google.com/maps/*",
    "https://maps.google.com/*",
    "https://*.google.co.th/maps/*",
    "https://*.google.co.jp/maps/*",
    "https://*.google.com.sg/maps/*",
    "https://*.google.com.tw/maps/*",
    "https://*.google.com.hk/maps/*",
    "https://*.google.co.uk/maps/*",
    "https://*.google.com.au/maps/*",
    "https://*.google.ca/maps/*",
    "https://*.google.fr/maps/*",
    "https://*.google.de/maps/*",
    "https://*.google.it/maps/*",
    "https://*.google.es/maps/*",
    "https://maps.app.goo.gl/*",
    "https://goo.gl/maps/*",
    "https://*.tabelog.com/*",
    "https://*.xiaohongshu.com/*",
    "https://*.booking.com/*",
    "https://liuh886.github.io/ownly/*",
    "https://zhihaol.eu.org/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ownly Capture"
  },
  "commands": {
    "quick-capture-place": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Quickly capture current place to active trip"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.google.com/maps/*",
        "https://maps.google.com/*",
        "https://*.google.co.th/maps/*",
        "https://*.google.co.jp/maps/*",
        "https://*.google.com.sg/maps/*",
        "https://*.google.com.tw/maps/*",
        "https://*.google.com.hk/maps/*",
        "https://*.google.co.uk/maps/*",
        "https://*.google.com.au/maps/*",
        "https://*.google.ca/maps/*",
        "https://*.google.fr/maps/*",
        "https://*.google.de/maps/*",
        "https://*.google.it/maps/*",
        "https://*.google.es/maps/*",
        "https://maps.app.goo.gl/*",
        "https://goo.gl/maps/*",
        "https://*.tabelog.com/*",
        "https://*.xiaohongshu.com/*",
        "https://*.booking.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://liuh886.github.io/ownly/*",
        "https://zhihaol.eu.org/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["ownly-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
